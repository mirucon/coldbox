{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardApproval": false,
  "timezone": "Asia/Tokyo",
  "schedule": [
    "* 0-7 * * 6"
  ],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 2,
  "prHourlyLimit": 0,
  "automerge": false,
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "on the first day of the month"
    ]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": false,
    "schedule": [
      "at any time"
    ]
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "*"
      ],
      "dependencyDashboardApproval": false
    },
    {
      "description": "Filter Composer updates against composer.json's PHP >=7.4 support target",
      "matchDatasources": [
        "packagist"
      ],
      "constraintsFiltering": "strict"
    },
    {
      "description": "WordPress core's official wp-phpunit bootstrap requires PHPUnit 9.x",
      "matchDatasources": [
        "packagist"
      ],
      "matchPackageNames": [
        "phpunit/phpunit"
      ],
      "allowedVersions": "<10.0.0"
    },
    {
      "description": "Keep Font Awesome 5/6 class and font-family compatibility for existing sites and child themes",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "@fortawesome/fontawesome-free"
      ],
      "allowedVersions": "<7.0.0"
    },
    {
      "description": "Track MySQL LTS lines in CI rather than short-lived Innovation releases",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mysql"
      ],
      "allowedVersions": "/^8\\.(0|4)(\\..+)?$/"
    },
    {
      "description": "Track active/maintenance LTS Node.js lines in .nvmrc",
      "matchManagers": [
        "nvm"
      ],
      "allowedVersions": "/^(22|24)(\\..+)?$/"
    },
    {
      "matchManagers": [
        "composer",
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Development and asset dependencies"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "pinDigests": true
    }
  ]
}
